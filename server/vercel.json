{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "crons": [
    { "path": "/admin/internal/acknowledge-sweep", "schedule": "*/15 * * * *" }
  ]
}
