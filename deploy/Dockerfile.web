# Hive Admin console
#
# NEXT_PUBLIC_ADMIN_API is baked in at BUILD time — it ends up in the client
# bundle and in the CSP connect-src that middleware.ts emits. Changing the API
# origin means rebuilding, not restarting.

FROM node:22-alpine AS builder

WORKDIR /app

COPY web/package*.json ./
RUN npm ci --no-audit --no-fund

COPY web/ ./

ARG NEXT_PUBLIC_ADMIN_API
ENV NEXT_PUBLIC_ADMIN_API=$NEXT_PUBLIC_ADMIN_API
RUN test -n "$NEXT_PUBLIC_ADMIN_API" || \
    (echo "NEXT_PUBLIC_ADMIN_API build arg is required — it is pinned into the CSP" && exit 1)

RUN npm run build

# ── Runtime ──────────────────────────────────────────────────────────────────

FROM node:22-alpine

WORKDIR /app

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/next.config.ts ./
COPY --from=builder /app/public ./public

USER node

ENV NODE_ENV=production
ENV PORT=3100
EXPOSE 3100

CMD ["npx", "next", "start", "-p", "3100"]
