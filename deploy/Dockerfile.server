# Hive Admin API
#
# Single instance only. The demo data driver keeps state in process memory —
# including admin sessions — so a second replica would reject tokens minted by
# the first. Scaling requires ADMIN_DATA_DRIVER=dynamodb, at which point the
# store is shared and replicas are fine.

FROM node:22-alpine

WORKDIR /app

# Dependencies first so a code change does not reinstall them.
COPY server/package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY server/ ./

# Runs as a non-root user. node:alpine ships one.
USER node

ENV NODE_ENV=production
ENV ADMIN_PORT=4000
EXPOSE 4000

# The platform's own health check should point here — it is the same endpoint
# bond-srv uses, and it does not touch the data layer.
HEALTHCHECK --interval=30s --timeout=4s --start-period=8s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:4000/admin/healthz',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["node", "index.js"]
